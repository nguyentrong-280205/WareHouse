NODE_ENV=development
AUTH_ALLOW_SIMPLE_DEMO=false
HOST=127.0.0.1
PORT=3000
# Replace CHANGE_ME_PORT with the observed TCP port of your named instance.
# Use URL-encoded credentials; trustServerCertificate=true is for local development.
DATABASE_URL=sqlserver://warehouse_app:CHANGE_ME@NGUYENTRONG-200:CHANGE_ME_PORT/warehouse_db?instance=HTTT02&trustServerCertificate=true
MIGRATION_DATABASE_URL=sqlserver://warehouse_migration:CHANGE_ME@NGUYENTRONG-200:CHANGE_ME_PORT/warehouse_db?instance=HTTT02&trustServerCertificate=true
TEST_DATABASE_URL=sqlserver://warehouse_test_app:CHANGE_ME@NGUYENTRONG-200:CHANGE_ME_PORT/warehouse_test?instance=HTTT02&trustServerCertificate=true
TEST_MIGRATION_DATABASE_URL=sqlserver://warehouse_test_migration:CHANGE_ME@NGUYENTRONG-200:CHANGE_ME_PORT/warehouse_test?instance=HTTT02&trustServerCertificate=true
TEST_INSTANCE_ID=CHANGE_ME_TEST_UUID
TEST_ALLOWED_ENDPOINTS=NGUYENTRONG-200:CHANGE_ME_PORT
CSRF_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOG_LEVEL=info
# UC01 approved costs. Secure=true mandatory for HTTPS deployment.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_COOKIE_SECURE=false
